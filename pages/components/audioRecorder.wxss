.audio-recorder {
  margin: 20rpx 0;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
}

.record-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #f8f8f8;
  border-radius: 44rpx;
  transition: all 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.recording {
  background: #ff4d4f;
  color: #fff;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
  100% {
    transform: scale(1);
  }
}

.record-text {
  font-size: 28rpx;
  font-weight: 500;
}

.audio-player {
  margin-top: 24rpx;
  display: flex;
  gap: 24rpx;
}

.play-btn, .delete-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 40rpx;
  transition: all 0.3s;
  border: none;
}

.play-btn {
  background: var(--primary-color);
  color: #fff;
}

.delete-btn {
  background: #f5f5f5;
  color: #333;
}

.play-btn:active, .delete-btn:active {
  opacity: 0.8;
} 