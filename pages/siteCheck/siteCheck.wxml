<view class="container">
  <!-- 基本信息区域 - 隐藏但保留功能 -->
  <view class="info-section" style="display: none;">
    <picker mode="date" value="{{checkInfo.date}}" bindchange="onDateChange">
      <view class="picker-value">{{checkInfo.date}}</view>
    </picker>
    <picker mode="time" value="{{checkInfo.time}}" bindchange="onTimeChange">
      <view class="picker-value">{{checkInfo.time}}</view>
    </picker>
    <input class="location-input" value="{{checkInfo.location}}" bindinput="onLocationInput"/>
  </view>

  <!-- 录音组件 -->
  <view class="info-section">
    <view class="section-title">现场录音</view>
    <audio-recorder 
      bind:recordComplete="onRecordComplete" 
      bind:recordDelete="onRecordDelete"
    />
  </view>

  <!-- 问题列表 -->
  <view class="questions">
    <view class="question" wx:for="{{questions}}" wx:key="id">
      <view class="question-title">{{item.title}}</view>
      <view class="answer-options">
        <view class="option {{item.answer === true ? 'selected' : ''}}" 
              bindtap="onAnswer" 
              data-id="{{item.id}}" 
              data-value="true">是</view>
        <view class="option {{item.answer === false ? 'selected' : ''}}" 
              bindtap="onAnswer" 
              data-id="{{item.id}}" 
              data-value="false">否</view>
      </view>
    </view>
  </view>

  <!-- 总体评级区域 -->
  <view class="rating-section">
    <view class="section-title">总体评级</view>
    <view class="rating-options">
      <view class="rating-option {{overallRating === 'A' ? 'selected' : ''}}" 
            bindtap="setRating" 
            data-rating="A">A</view>
      <view class="rating-option {{overallRating === 'B' ? 'selected' : ''}}" 
            bindtap="setRating" 
            data-rating="B">B</view>
      <view class="rating-option {{overallRating === 'C' ? 'selected' : ''}}" 
            bindtap="setRating" 
            data-rating="C">C</view>
    </view>
  </view>

  <!-- 备注区域 -->
  <view class="remarks-section">
    <view class="section-title">备注</view>
    <textarea class="remarks-input" 
              placeholder="请输入备注信息" 
              bindinput="onRemarksInput"
              value="{{remarks}}"></textarea>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" 
          type="primary" 
          bindtap="submitCheck">提交检查结果</button>
</view> 