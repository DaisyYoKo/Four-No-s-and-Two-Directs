/**index.wxss**/
/* 设置页面高度为视窗高度 */
page {
  height: 100vh;
}

/* 主容器样式，采用flex布局 */
.container {
  height: 100vh;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 用户信息卡片样式 */
.user-info {
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 101;
}

/* 用户头像样式 */
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;  /* 圆形头像 */
  margin-right: 20rpx;
}

/* 用户详细信息容器 */
.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;  /* 用户名和部门之间的间距 */
}

/* 用户昵称样式 */
.nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color);
}

/* 部门信息样式 */
.department {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 搜索框容器样式 */
.search-container {
  position: relative;
  width: 100%;
  margin-bottom: 20rpx;
  z-index: 101;
}

/* 搜索框输入框样式 */
.search-input {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 80rpx 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 搜索图标样式 */
.search-icon {
  width: 40rpx;
  height: 40rpx;
  padding: 8rpx;
}

/* 地图容器样式 - 移除了顶部间距，使地图填充更多空间 */
.map-container {
  flex: 1;
  width: 100%;
  min-height: 75vh;  /* 增加地图占比 */
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative; /* 添加相对定位，用于按钮定位参考 */
}

/* 地图组件样式 */
.map-container map {
  width: 100%;
  height: 100%;
}

/* 地图头部容器 - 当前已隐藏 */
.map-header {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  display: none; /* 隐藏删除按钮 */
  /* 如需显示删除按钮，将 display: none 改为 display: block */
}

/* 清除按钮样式 - 当前已隐藏，但保留样式供后续使用 */
.clear-btn {
  font-size: 24rpx;
  padding: 12rpx 30rpx;
  background: rgba(255, 77, 79, 0.9);
  color: #fff;
  border-radius: 24rpx;
  margin: 0;
  line-height: 1.5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 清除按钮悬停效果 */
.clear-btn:active {
  opacity: 0.8;
}

/* 删除功能按钮相关样式 */
.function-buttons,
.function-btn {
  display: none;
}

/* 搜索相关样式 */
.search-container {
  position: relative;
  width: 100%;
  margin-bottom: 20rpx;
  z-index: 101;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 80rpx 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-icon-wrapper {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* 搜索结果列表样式 */
.search-results {
  position: absolute;
  top: 240rpx;
  left: 20rpx;
  right: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  max-height: 800rpx;
  overflow-y: auto;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.result-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.result-item:last-child {
  border-bottom: none;
}

.result-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.result-info {
  font-size: 24rpx;
  color: #666;
  display: flex;
  gap: 16rpx;
}

.result-status {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.result-status.complete {
  color: var(--primary-color);
}

.result-status.incomplete {
  color: #ff4d4f;
}

.no-result {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
