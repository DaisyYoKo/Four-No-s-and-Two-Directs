<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 用户信息卡片 -->
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl}}"></image>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickName}}</text>
        <text class="department">{{userInfo.department}}</text>
      </view>
    </view>

    <!-- 搜索框 -->
    <view class="search-container">
      <input class="search-input" 
             placeholder="搜索公司名称、地址、负责人等" 
             bindinput="onSearchInput"
             value="{{searchKeyword}}"
      />
      <view class="search-icon-wrapper">
        <icon wx:if="{{!searchKeyword}}" 
              class="search-icon" 
              type="search" 
              size="20"
        />
        <icon wx:else 
              class="search-icon" 
              type="clear" 
              size="20"
              bindtap="clearSearch"
        />
      </view>
    </view>

    <!-- 搜索结果列表 -->
    <view class="search-results" wx:if="{{showSearchResult}}">
      <block wx:if="{{searchResults.length > 0}}">
        <view class="result-item" 
              wx:for="{{searchResults}}" 
              wx:key="id"
              bindtap="onSearchResultTap"
              data-id="{{item.id}}">
          <view class="result-title">{{item.callout.content}}</view>
          <view class="result-info" wx:if="{{item.info}}">
            <text wx:if="{{item.info.companyType}}">{{item.info.companyType}}</text>
            <text wx:if="{{item.info.address}}">{{item.info.address}}</text>
          </view>
          <view class="result-status {{item.info ? 'complete' : 'incomplete'}}">
            {{item.info ? '信息完整' : '信息待完善'}}
          </view>
        </view>
      </block>
      <view wx:else class="no-result">
        <text>未找到相关信息</text>
      </view>
    </view>

    <!-- 地图容器 -->
    <view class="map-container">
      <view class="map-header">
        <button class="clear-btn" bindtap="clearAllMarkers">清除所有标记</button>
      </view>
      <map id="myMap"
           longitude="{{longitude}}"
           latitude="{{latitude}}"
           scale="{{scale}}"
           markers="{{markers}}"
           show-location
           bindtap="onMapTap"
           bindmarkertap="onMarkerTap">
      </map>
    </view>
  </view>
</scroll-view>
