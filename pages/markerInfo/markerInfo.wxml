<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">
      <icon type="back" size="20" color="#333"/>
      <text class="back-text">返回</text>
    </view>
    <text class="page-title">点位信息</text>
    <view class="delete-btn" bindtap="deleteMarker">
      <icon type="cancel" size="20" color="#ff4d4f"/>
      <text class="delete-text">删除</text>
    </view>
  </view>

  <!-- 信息表单 -->
  <view class="form-container">
    <view class="section-header">企业信息</view>
    <view class="info-section">
      <view class="form-item">
        <text class="label">公司名称<text class="required">*</text></text>
        <input class="input" 
               value="{{markerInfo.companyName}}" 
               disabled="{{!isEditing}}"
               bindinput="onCompanyNameInput"
               placeholder="请输入公司名称"/>
      </view>

      <view class="form-item">
        <text class="label">公司性质<text class="required">*</text></text>
        <input class="input" 
               value="{{markerInfo.companyType}}" 
               disabled="{{!isEditing}}"
               bindinput="onCompanyTypeInput"
               placeholder="请输入公司性质"/>
      </view>

      <view class="form-item">
        <text class="label">公司地址<text class="required">*</text></text>
        <input class="input" 
               value="{{markerInfo.address}}" 
               disabled="{{!isEditing}}"
               bindinput="onAddressInput"
               placeholder="请输入公司地址"/>
      </view>
    </view>

    <view class="section-header">负责人信息</view>
    <view class="info-section">
      <view class="form-item">
        <text class="label">负责人姓名<text class="required">*</text></text>
        <input class="input" 
               value="{{markerInfo.contactName}}" 
               disabled="{{!isEditing}}"
               bindinput="onContactNameInput"
               placeholder="请输入负责人姓名"/>
      </view>

      <view class="form-item">
        <text class="label">负责人电话<text class="required">*</text></text>
        <input class="input" 
               value="{{markerInfo.contactPhone}}" 
               disabled="{{!isEditing}}"
               bindinput="onContactPhoneInput"
               placeholder="请输入负责人电话"/>
      </view>
    </view>

    <view class="section-header">现场照片</view>
    <view class="info-section">
      <view class="image-upload" bindtap="{{isEditing ? 'chooseImage' : ''}}">
        <image wx:if="{{markerInfo.image}}" 
               src="{{markerInfo.image}}" 
               mode="aspectFill" 
               class="preview-image"/>
        <view wx:else class="upload-placeholder">
          <icon type="camera" size="30"/>
          <text>点击上传照片（选填）</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-buttons">
    <button class="btn edit-btn" bindtap="toggleEdit">
      {{isEditing ? '完成' : '修改'}}
    </button>
    <button class="btn save-btn" bindtap="saveInfo" wx:if="{{isEditing}}">
      保存
    </button>
  </view>
</view> 