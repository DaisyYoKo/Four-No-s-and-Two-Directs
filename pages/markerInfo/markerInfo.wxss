/* 页面整体样式设置 */
page {
  min-height: 100vh;
  background: var(--bg-color);
}

/* 主容器样式 */
.container {
  box-sizing: border-box;
  padding-top: 88rpx; /* 导航栏高度 */
  padding-bottom: 120rpx; /* 底部按钮区域高度 */
}

/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.back-btn, .delete-btn {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.back-text, .delete-text {
  font-size: 28rpx;
  margin-left: 8rpx;
}

.delete-text {
  color: #ff4d4f;
}

.page-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 表单容器样式 */
.form-container {
  background: #fff;
  width: 100%;
}

/* 区域标题样式 */
.section-header {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

/* 信息区域样式 */
.info-section {
  background: #fff;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

/* 表单项样式 */
.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

/* 标签样式 */
.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.required {
  color: #ff4d4f;
  margin-left: 4rpx;
}

/* 输入框样式 */
.input {
  width: 100%;
  height: 88rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input[disabled] {
  background: #f8f8f8;
  color: #666;
}

/* 图片上传区域样式 */
.image-upload {
  width: 100%;
  height: 400rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 28rpx;
}

/* 底部按钮区域样式 */
.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 按钮样式 - 与其他页面保持一致 */
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin: 0 12rpx;
  border: none;
}

.edit-btn {
  background: #f8f8f8;
  color: #333;
}

.save-btn {
  background: var(--primary-color);
  color: #fff;
}

/* 交互状态 */
.btn:active {
  opacity: 0.8;
}

.input:focus {
  background: #f0f0f0;
}

.image-upload:active {
  opacity: 0.8;
} 