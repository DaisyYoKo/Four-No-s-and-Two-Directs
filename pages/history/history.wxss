/* 容器样式 */
.container {
  padding: 0;
  background: var(--bg-color);
  min-height: 100vh;
}

/* 历史记录列表样式 */
.history-list {
  width: 100%;
}

/* 历史记录项样式 */
.history-item {
  background: #fff;
  margin-bottom: 2rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 内容区域样式 */
.item-content {
  padding: 24rpx 30rpx;
}

/* 头部信息样式 */
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 标题样式 */
.item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color);
}

/* 时间样式 */
.item-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 信息内容样式 */
.item-info {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 评级样式 */
.rating {
  color: var(--primary-color);
}

/* 录音标记样式 */
.audio-mark {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--primary-color);
  font-size: 24rpx;
}

/* 空记录提示样式 */
.empty-tip {
  text-align: center;
  color: var(--text-secondary);
  font-size: 28rpx;
  margin-top: 40%;
} 